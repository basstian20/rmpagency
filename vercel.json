{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/id", "destination": "/", "permanent": true },
    { "source": "/id/", "destination": "/", "permanent": true },
    { "source": "/id/index.html", "destination": "/", "permanent": true },
    { "source": "/id/about", "destination": "/about", "permanent": true },
    { "source": "/id/about.html", "destination": "/about", "permanent": true },
    { "source": "/id/services", "destination": "/services", "permanent": true },
    { "source": "/id/services.html", "destination": "/services", "permanent": true },
    { "source": "/id/project", "destination": "/project", "permanent": true },
    { "source": "/id/project.html", "destination": "/project", "permanent": true },
    { "source": "/id/projects", "destination": "/project", "permanent": true },
    { "source": "/id/projects.html", "destination": "/project", "permanent": true },
    { "source": "/id/contact", "destination": "/contact", "permanent": true },
    { "source": "/id/contact.html", "destination": "/contact", "permanent": true },
    { "source": "/projects", "destination": "/project", "permanent": true },
    { "source": "/projects.html", "destination": "/project", "permanent": true },
    { "source": "/en/projects", "destination": "/en/project", "permanent": true },
    { "source": "/en/projects.html", "destination": "/en/project", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://wa.me"
        }
      ]
    }
  ]
}
